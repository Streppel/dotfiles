{
  "style": "~/.config/waybar/style.css",
  
  "layer": "top",
  "position": "top",
  "height": 36,
  
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
  ],
  
  "modules-center": [
    "memory",
    "cpu",
    "temperature",
    "custom/gpu",
    "disk"
  ],
  
  "modules-right": [
    "idle_inhibitor",
    "battery",
    "hyprland/language",
    "keyboard-state",
    "backlight",
    "pulseaudio",
    "network",
    "bluetooth",
    "clock",
    "custom/notification",
    "tray"
  ],

  "include": "~/.config/waybar/modules.jsonc"
}
